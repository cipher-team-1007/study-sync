# StudySync — Environment Configuration Template
#
# INSTRUCTIONS FOR DEVELOPERS:
# 1. Copy this file to create your local environment file:
#    cp .env.example .env.local
# 2. Fill in your project credentials from your Supabase Dashboard (Settings -> API).
# 3. NEVER commit .env.local or any real secrets to Git.

# ==============================================================================
# 1. Supabase Client Configuration (Public / Browser & Server)
# ==============================================================================
# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://placeholder-project-id.supabase.co"

# Your Supabase Public Anonymous API Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY="placeholder-anon-key-replace-with-your-own"

# ==============================================================================
# 2. Application Environment Settings
# ==============================================================================
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_NAME="StudySync"
